# Server Configuration
PORT=5000
NODE_ENV=development

# AI Provider Selection: 'mock' | 'gemini' | 'groq' | 'kimi'
AI_PROVIDER=mock

# AI Provider API Keys
GEMINI_API_KEY=
GROQ_API_KEY=
KIMI_API_KEY=
OPENROUTER_API_KEY=

# Optional model for credentials supplied through this environment.
# Otherwise select a live model in the application's Settings.
AI_MODEL=
MONGODB_URI=mongodb://localhost:27017/loga-kimi
FRONTEND_URL=http://localhost:3000

# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this stable: saved API keys depend on it for decryption.
CREDENTIAL_ENCRYPTION_KEY=

